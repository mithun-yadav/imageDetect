
# API configuration
API_PORT=3000

# YOLO inference configuration
MODEL_HOST_PATH=./runs/train/coco128-four-class/weights/best.pt
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640
DEVICE=cpu

# PostgreSQL configuration
POSTGRES_DB=image_detection
POSTGRES_USER=image_detection_user
POSTGRES_PASSWORD=replace_with_a_strong_password

# API database connection
DATABASE_URL=postgresql://image_detection_user:replace_with_a_strong_password@postgres:5432/image_detection?schema=public
